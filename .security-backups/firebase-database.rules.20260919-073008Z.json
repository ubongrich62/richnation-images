{
  "rules": {
    ".read": false,
    ".write": false,

    // Locked to the admin:true custom claim (the same one richnation-wallet-worker.js's
    // /set-admin-claim grants, confirmed working after fixing admin.html's login
    // migration). Previously .read:true/.write:true with no auth check at all -
    // "vault"/"notes" implies something sensitive, and there's no legitimate reason
    // for that to be world-readable/writable. A real admin's Firebase ID token
    // carries the claim, so this doesn't change how the admin actually uses it.
    "mgmt_vault": { ".read": "auth != null && auth.token.admin === true", ".write": "auth != null && auth.token.admin === true" },
    "mgmt_notes": { ".read": "auth != null && auth.token.admin === true", ".write": "auth != null && auth.token.admin === true" },

    // Not part of the RichNation Mall app (no rn_mall_ prefix, not referenced by
    // any of index/admin/vendor/staff/rider/investor.html) - left exactly as-is,
    // out of scope for this audit, some other tool depends on these.
    "channel_settings": { ".read": true, ".write": true },
    "channels":         { ".read": true, ".write": true },
    "announcements":    { ".read": true, ".write": true },
    "presence":         { ".read": true, ".write": true },
    "fcm_tokens":       { ".read": true, ".write": true },
    "push_queue":       { ".read": true, ".write": true },
    "divisions":        { ".read": true, ".write": true },
    "dm":               { ".read": true, ".write": true },
    "staff":            { ".read": true, ".write": true },
    "staff_logins":     { ".read": true, ".write": true },
    "budget_entries":   { ".read": true, ".write": true },

    "rn_mall_products":        { ".read": true, ".write": true, "$id": { ".validate": "newData.hasChildren(['name','price'])" } },
    "rn_mall_categories":      { ".read": true, ".write": true },
    "rn_mall_reviews":         { ".read": true, ".write": true },
    "rn_mall_seasonal_promos": { ".read": true, ".write": true },
    "rn_mall_coupons":         { ".read": true, ".write": true },
    "rn_mall_bundles":         { ".read": true, ".write": true },
    // Read stays public - every one of the six apps loads this unauthenticated
    // (paystackKey, walletWorkerUrl, pushWorkerUrl, etc. all need to be
    // readable before anyone signs in). Write is now admin-only: this used to
    // be wide open, letting anyone redirect every customer's checkout to
    // their own Paystack account or a lookalike wallet Worker with a single
    // unauthenticated PATCH.
    "rn_mall_settings":        { ".read": true, ".write": "auth != null && auth.token.admin === true" },
    "rn_mall_announcements":   { ".read": true, ".write": true },

    "rn_mall_customers": {
      // Was fully public read+write (validate only ever protected the two
      // money fields) - anyone could list every customer's name/email/phone/
      // address/order-history references in one request, or directly edit
      // any OTHER customer's account (accountStatus, wholesaleStatus,
      // address, etc.) with no ownership check at all. Bulk (whole-
      // collection) reads are only ever done by admin/staff/investor
      // dashboards or the wallet Worker (verified: index.html never bulk-
      // reads this outside its own login/register/forgot-password flows,
      // which only need to find ONE matching record, not read everyone
      // else's data back to the browser). A single record stays readable/
      // writable by its own owner (checked the same two ways as everywhere
      // else in this app - the key itself is the uid, or the record's own
      // authUid field matches) for every ordinary self-service action
      // (address, phone, wallet redeem via the Worker, etc.), plus admin/
      // staff for the account-status/wholesale actions their dashboards
      // already do, plus worker for the money fields the .validate below
      // still separately protects. Creating a brand-new record stays open,
      // unchanged - registration itself is still meant to be public.
      ".read": "auth != null && (auth.token.admin === true || auth.token.staff === true || auth.token.investor === true || auth.token.worker === true)",
      "$id": {
        ".read": "auth != null && (auth.uid === $id || data.child('authUid').val() === auth.uid || auth.token.admin === true || auth.token.staff === true || auth.token.investor === true || auth.token.worker === true)",
        ".write": "!data.exists() || (auth != null && (auth.uid === $id || data.child('authUid').val() === auth.uid || auth.token.admin === true || auth.token.staff === true || auth.token.worker === true))",
        ".validate": "newData.hasChildren(['email','id']) && ((auth != null && auth.token.worker === true) || (data.child('walletBalance').exists() ? newData.child('walletBalance').val() === data.child('walletBalance').val() : (!newData.hasChild('walletBalance') || newData.child('walletBalance').val() === 0))) && ((auth != null && auth.token.worker === true) || (data.child('points').exists() ? newData.child('points').val() === data.child('points').val() : (!newData.hasChild('points') || newData.child('points').val() === 0)))"
      }
    },
    "rn_mall_staff": {
      ".read": true,
      "$id": {
        // Anyone could previously write a fully-formed record here directly
        // (role:'ceo', status:'active', adminPanelAccess:true, any password),
        // completely bypassing both the real "apply, then admin approves"
        // flow and staff.html/admin.html's own login gates, which only check
        // fields already sitting unprotected in this same record. Login
        // itself already refuses status!=='active' (pending_review/suspended
        // both blocked), so the one thing that actually needed protecting was
        // never letting status/role/adminPanelAccess move without an admin -
        // a brand new application is only ever allowed to land as
        // status:'pending_review' with no adminPanelAccess claim, and once a
        // record exists, those three fields can only ever be carried forward
        // unchanged unless the write carries the admin claim. This doesn't
        // affect the self-migration write (setting authUid, nulling
        // password) or ordinary self-service edits (phone, address, photo,
        // fcmTokens) - none of them ever touch these three fields anyway.
        ".write": "(auth != null && auth.token.admin === true) || (!data.exists() ? (newData.child('status').val() === 'pending_review' && !newData.hasChild('adminPanelAccess')) : (data.child('role').val() === newData.child('role').val() && data.child('status').val() === newData.child('status').val() && data.child('adminPanelAccess').val() === newData.child('adminPanelAccess').val()))",
        ".validate": "newData.hasChildren(['email','id']) && ((auth != null && auth.token.worker === true) || (data.child('salary').exists() ? newData.child('salary').val() === data.child('salary').val() : (!newData.hasChild('salary') || newData.child('salary').val() === 0))) && ((auth != null && auth.token.worker === true) || (data.child('points').exists() ? newData.child('points').val() === data.child('points').val() : (!newData.hasChild('points') || newData.child('points').val() === 0)))"
      }
    },
    "rn_mall_vendors": {
      ".read": true,
      "$id": {
        // Same shape of fix as rn_mall_staff above: vendor.html's own login
        // already refuses status 'pending' or 'suspended', so the one field
        // that actually needed protecting is status itself. A brand-new
        // application (the public "become a vendor" signup) may only ever
        // land as status:'pending' (matching that flow exactly); once a
        // vendor record exists, status can only be carried forward unchanged
        // unless the write carries the admin:true claim (admin.html's real
        // approve/suspend actions already do). The self-migration write
        // (authUid, nulling password) and ordinary self-service edits (store
        // details, products, fcmTokens) never touch status, so they're
        // unaffected.
        ".write": "(auth != null && auth.token.admin === true) || (!data.exists() ? newData.child('status').val() === 'pending' : data.child('status').val() === newData.child('status').val())",
        ".validate": "newData.hasChildren(['email','id'])"
      }
    },
    "rn_mall_riders": {
      ".read": true,
      "$id": {
        // Same shape of fix as rn_mall_staff/rn_mall_vendors above. rider.html's
        // login already refuses status 'pending_review' or 'suspended', so
        // status is the one field that actually needed protecting. A brand-new
        // application (the public "apply to be a rider" signup) may only ever
        // land as status:'pending_review' (matching that flow exactly); once a
        // record exists, status can only be carried forward unchanged unless
        // the write carries the admin:true claim (admin.html's approveRider/
        // toggleSuspendRider already have it). Self-migration and ordinary
        // self-service edits never touch status, so they're unaffected.
        ".write": "(auth != null && auth.token.admin === true) || (!data.exists() ? newData.child('status').val() === 'pending_review' : data.child('status').val() === newData.child('status').val())",
        ".validate": "newData.hasChildren(['email','id']) && ((auth != null && auth.token.worker === true) || (data.child('totalPaid').exists() ? newData.child('totalPaid').val() === data.child('totalPaid').val() : (!newData.hasChild('totalPaid') || newData.child('totalPaid').val() === 0))) && ((auth != null && auth.token.worker === true) || (data.child('points').exists() ? newData.child('points').val() === data.child('points').val() : (!newData.hasChild('points') || newData.child('points').val() === 0)))"
      }
    },
    "rn_mall_investors": {
      ".read": true,
      "$id": {
        // Same shape of fix as the other three role tables above.
        // investor.html's login already refuses status 'pending_review' or
        // 'suspended', so status is the one field that actually needed
        // protecting. A brand-new application (the public investor
        // application flow) may only ever land as status:'pending_review'
        // (matching that flow exactly); once a record exists, status can
        // only be carried forward unchanged unless the write carries the
        // admin:true claim. Self-migration and ordinary self-service edits
        // never touch status, so they're unaffected.
        ".write": "(auth != null && auth.token.admin === true) || (!data.exists() ? newData.child('status').val() === 'pending_review' : data.child('status').val() === newData.child('status').val())",
        ".validate": "newData.hasChildren(['email','id']) && ((auth != null && auth.token.worker === true) || (data.child('walletBalance').exists() ? newData.child('walletBalance').val() === data.child('walletBalance').val() : (!newData.hasChild('walletBalance') || newData.child('walletBalance').val() === 0))) && ((auth != null && auth.token.worker === true) || (data.child('totalPaid').exists() ? newData.child('totalPaid').val() === data.child('totalPaid').val() : (!newData.hasChild('totalPaid') || newData.child('totalPaid').val() === 0)))"
      }
    },

    // Self-migration UID index for each role: written by an account itself right
    // after createUserWithEmailAndPassword, linking its own real Firebase Auth uid
    // to its pre-existing rn_mall_<role> record (needed whenever that record's own
    // key isn't already the uid), and read by that same login flow's fallback
    // lookup on every later sign-in. None of these five had ANY rule before, so
    // every write here silently fell through to the top-level ".write": false
    // default and was always rejected - even for an admin token, since nothing
    // ever granted permission here at all. Discovered while manually relinking one
    // legacy staff account whose index write was rejected with a 401 despite a
    // valid admin session. This has likely been silently breaking self-migration
    // for every legacy account (any role) whose original id isn't already its uid,
    // for as long as this indexing scheme has existed.
    "rn_mall_customers_by_uid": { "$uid": { ".read": "auth != null", ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)" } },
    "rn_mall_staff_by_uid":     { "$uid": { ".read": "auth != null", ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)" } },
    "rn_mall_vendors_by_uid":   { "$uid": { ".read": "auth != null", ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)" } },
    "rn_mall_riders_by_uid":    { "$uid": { ".read": "auth != null", ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)" } },
    "rn_mall_investors_by_uid": { "$uid": { ".read": "auth != null", ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)" } },

    // Read stays public - deliberately, not an oversight: index.html's own
    // "frequently bought together" product-page feature and its homepage
    // order-count stat both bulk-read every order for ANY visitor, logged in
    // or not, and locking that down would break both without rebuilding them
    // around a separate, privacy-scrubbed aggregate (a real fix, just a
    // bigger one than this pass covers - noted, not silently dropped). Write
    // is the half that was actually dangerous and had NO check at all
    // (anyone could overwrite ANY order - redirect a delivery address,
    // fabricate a fake order, mark someone else's real order "delivered" -
    // regardless of who placed it): now limited to the order's own customer
    // (same ownership check used everywhere else in this app), or
    // admin/staff/rider (who each write real order fields as part of their
    // dashboards - assignment, status, delivery tracking) or worker (the
    // points/referral/refund bookkeeping fields it already patches).
    "rn_mall_orders": {
      ".read": true,
      "$id": {
        ".write": "!data.exists() ? (auth != null && (newData.child('customer').child('id').val() === auth.uid || root.child('rn_mall_customers').child(newData.child('customer').child('id').val()).child('authUid').val() === auth.uid || auth.token.admin === true || auth.token.staff === true)) : (auth != null && (data.child('customer').child('id').val() === auth.uid || root.child('rn_mall_customers').child(data.child('customer').child('id').val()).child('authUid').val() === auth.uid || auth.token.admin === true || auth.token.staff === true || auth.token.rider === true || auth.token.worker === true))"
      }
    },
    "rn_mall_customer_orders":              { "$id": { ".read": true, ".write": true } },
    "rn_mall_processed_topups":             { "$id": { ".read": "auth != null && auth.token.worker === true", ".write": "auth != null && auth.token.worker === true" } },
    "rn_mall_processed_payments":           { "$id": { ".read": "auth != null && auth.token.worker === true", ".write": "auth != null && auth.token.worker === true" } },
    // Write locked to admin/worker: this log is now trusted as independent
    // proof of a real wallet debit/credit when /refund-order decides whether
    // a customer's order was actually paid (see that function's comment in
    // richnation-wallet-worker.js) - if a customer could write here directly,
    // they could fabricate a matching "debit" entry for a fake order and
    // cash it out via refund-order regardless. admin.html's own direct writes
    // here (manual wallet adjustments, admin-initiated refunds) already carry
    // the admin's real ID token via fbAuthQS(), so they're unaffected.
    "rn_mall_wallet_transactions":          { "$id": { ".read": true, ".write": "auth != null && (auth.token.admin === true || auth.token.worker === true)" } },
    "rn_mall_wallet_transactions_investor": { "$id": { ".read": true, ".write": true } },
    "rn_mall_wallet_issues": { ".read": true, "$id": { ".write": true } },
    "rn_mall_vendor_payouts":               { "$id": { ".read": true, ".write": true } },
    "rn_mall_rider_payouts":                { "$id": { ".read": true, ".write": true } },
    "rn_mall_investor_payouts":             { "$id": { ".read": true, ".write": true } },
    "rn_mall_investor_withdrawals":         { "$id": { ".read": true, ".write": true } },
    "rn_mall_staff_withdrawals":            { "$id": { ".read": true, ".write": true } },
    "rn_mall_staff_salary_history":         { "$id": { ".read": true, ".write": true } },

    "rn_mall_chat": { "$id": { ".read": true, ".write": true } },

    "$topLevelPath": {
      ".read": "$topLevelPath.beginsWith('rn_mall_vendor_chat_') || $topLevelPath.beginsWith('rn_mall_investor_chat_') || $topLevelPath.beginsWith('rn_mall_rider_admin_chat_') || $topLevelPath.beginsWith('rna_')",
      ".write": "$topLevelPath.beginsWith('rn_mall_vendor_chat_') || $topLevelPath.beginsWith('rn_mall_investor_chat_') || $topLevelPath.beginsWith('rn_mall_rider_admin_chat_') || $topLevelPath.beginsWith('rna_')"
    },

    "rn_mall_notifications": { ".read": true, "$id": { ".write": true } },
    "rn_mall_admin_login_attempts": { "$id": { ".read": true, ".write": true } },
    "rn_mall_admin_fcm_tokens":     { "$id": { ".write": true } },
    "rn_mall_customer_notifications": { "$id": { ".read": true, ".write": true } },
    "rn_mall_vendor_notifications":   { "$id": { ".read": true, ".write": true } },
    "rn_mall_staff_notifications":    { "$id": { ".read": true, ".write": true } },
    "rn_mall_rider_notifications":    { "$id": { ".read": true, ".write": true } },
    "rn_mall_investor_notifications": { "$id": { ".read": true, ".write": true } },
    "rn_mall_announcement_reads":     { "$id": { ".read": true, ".write": true } },
    "rn_mall_activity_log":     { ".read": true, "$id": { ".write": true } },
    "rn_mall_investor_updates": { ".read": true, "$id": { ".write": true } },
    "rn_mall_rider_activity_log":   { "$id": { ".read": true, ".write": true } },
    "rn_mall_deleted_products_log": { "$id": { ".read": true, ".write": true } },
    "rn_mall_investor_switch_log":  { "$id": { ".read": true, ".write": true } },
    "rn_mall_rider_points_log":     { "$id": { ".read": true, ".write": true } },
    "rn_mall_staff_points_log":     { "$id": { ".read": true, ".write": true } },

    "rn_mall_rider_leave":      { "$id": { ".read": true, ".write": true } },
    "rn_mall_staff_leave":      { ".read": true, "$id": { ".write": true } },
    "rn_mall_rider_complaints": { "$id": { ".read": true, ".write": true } },
    "rn_mall_staff_complaints": { ".read": true, "$id": { ".write": true } },
    "rn_mall_rider_reports":    { "$id": { ".read": true, ".write": true } },
    "rn_mall_staff_reports":    { ".read": true, "$id": { ".write": true } },
    "rn_mall_staff_submissions": { ".read": true, "$id": { ".write": true } },
    "rn_mall_staff_tasks":      { ".read": true, "$id": { ".write": true } },
    "rn_mall_logistics_vehicles": { ".read": true, "$id": { ".write": true } },

    "rn_mall_newsletter_subscribers": { ".write": true, "$id": { ".read": true } },

    "rn_mall_analytics": { ".read": true, "$date": { ".write": true } }
  }
}
