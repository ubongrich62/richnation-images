// RichNation Mall — Firebase Realtime Database Security Rules, INTERIM version.
//
// This file is NOT applied automatically. Nothing in this repo, and no tool
// this session has access to, can push rules to your live Firebase project.
// Paste the "rules" object below into:
//   Firebase Console -> your project -> Realtime Database -> Rules -> Publish
// The Firebase rules editor accepts these // comments directly, this is not
// stripped-down JSON, you can paste the whole file as-is.
//
// !! DEPLOY ORDER MATTERS, DO THIS FIRST !! This version locks
// walletBalance/points/salary/totalPaid so they can only be changed by
// richnation-wallet-worker.js (see that file). If you publish these rules
// BEFORE that Worker is deployed and its URL + admin key are saved in
// Site Customiser, every wallet/points/salary/payout action across all six
// apps will start failing with a permissions error, nothing will be lost or
// corrupted, but customers won't earn RichPoints, admin's Adjust Wallet will
// stop working, etc, until the Worker is live. Deploy the Worker first,
// save its URL, THEN publish these rules.
//
// WHY THIS IS "INTERIM", NOT FINAL:
// Every portal's login (doLogin/doStaffLogin/doVendorRegister/etc.) works by
// downloading the ENTIRE customers/staff/vendors/riders/investors table into
// the browser and searching it client-side for a matching email, because
// there is no Firebase Auth yet, only a custom password field checked in JS.
// Firebase Rules cannot tell "the app doing a legitimate login lookup" apart
// from "anyone else hitting the same REST endpoint" — they see an identical
// request either way. So those five collections MUST stay readable as a
// whole table for the app to keep working at all under its current design,
// or every login screen breaks. That is a real, known, accepted residual
// exposure that only goes away once Firebase Auth actually replaces this
// login flow (see the audit's Section F migration plan) — these rules
// cannot fix it, and pretending otherwise would be dishonest.
//
// A handful of other collections have the same problem for the same reason:
// admin.html's Orders list, Wallet Issues page, notification bell, and
// activity feed, and staff.html's leave/complaints/reports/submissions/
// tasks/vehicles admin views, all fetch their whole collection and render
// it as a list, exactly like the login lookups above. Those stay
// collection-readable too, marked individually below with the same caveat.
//
// What these rules DO fix, right now, without Firebase Auth:
//   - No more wildcard writes that could overwrite/wipe an entire collection
//     in one request — writes are scoped to a specific record id, matching
//     how the app already writes.
//   - New account records must at least have the shape of a real account
//     (an email and an id), rejecting arbitrary junk payloads.
//   - Every genuinely internal/financial collection that the app only ever
//     accesses by a specific known id is locked to per-id access, closing
//     off full-collection dumps of wallet transactions, payouts, chat
//     threads, and per-role notification/activity data.
//   - The newsletter list can still accept public signups, but can no
//     longer be downloaded wholesale by anyone who finds the URL.
{
  "rules": {
    ".read": false,
    ".write": false,

    // Not part of this app, unrelated data you already keep in this same
    // Firebase project. Kept explicitly denied here (on top of the root
    // deny-by-default above, which already covers them) since that's how
    // your current live rules already have them.
    "mgmt_vault": { ".read": false, ".write": false },
    "mgmt_notes": { ".read": false, ".write": false },

    // Also not part of RichNation Mall — this same Firebase project hosts at
    // least one other app (an "rna_"-prefixed academy/staff-chat system,
    // plus a few loose top-level collections). Nothing in this repo touches
    // that app's code, so its actual read/write access patterns are unknown
    // here — locking it down without seeing its source could easily break
    // it. Left exactly as open as it already was (root default before this
    // file existed), not newly secured, not newly broken either. Securing
    // that app properly is a separate task for whoever maintains its code.
    "channel_settings": { ".read": true, ".write": true },
    "divisions":        { ".read": true, ".write": true },
    "dm":               { ".read": true, ".write": true },
    "staff":            { ".read": true, ".write": true },
    "staff_logins":     { ".read": true, ".write": true },

    "rn_mall_products":        { ".read": true, ".write": true, "$id": { ".validate": "newData.hasChildren(['name','price'])" } },
    "rn_mall_categories":      { ".read": true, ".write": true },
    "rn_mall_reviews":         { ".read": true, ".write": true },
    "rn_mall_seasonal_promos": { ".read": true, ".write": true },
    "rn_mall_coupons":         { ".read": true, ".write": true },
    "rn_mall_bundles":         { ".read": true, ".write": true },
    "rn_mall_settings":        { ".read": true, ".write": true },
    "rn_mall_announcements":   { ".read": true, ".write": true },

    // Login lookups: whole-collection read is required for the current
    // login flow to work at all, see the note above. Writes are scoped to
    // a specific $id so a request can't replace or wipe the whole table.
    //
    // MONEY FIELDS ARE NOW LOCKED against direct writes from any of the six
    // app pages. Before this, a customer's own browser could PATCH its own
    // walletBalance/points to any number it liked and immediately spend a
    // fabricated balance on a real order, admin.html could do the same for
    // staff salary/vendor/rider/investor payout totals, all with nothing
    // checking that the new number made any sense. The pattern below says
    // "this field may only stay exactly what it already was" for a normal
    // client write; the ONLY way it can actually change now is through
    // richnation-wallet-worker.js, which writes using a trusted credential
    // that these rules automatically don't apply to (the same mechanism the
    // Firebase Admin SDK uses), see that file's comments for the full
    // explanation. A brand new record may only be created with these
    // fields absent or zero, never a starting balance the browser made up,
    // real starting bonuses are credited by that same Worker right after
    // signup instead.
    "rn_mall_customers": {
      ".read": true,
      "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['email','id']) && (data.child('walletBalance').exists() ? newData.child('walletBalance').val() === data.child('walletBalance').val() : (!newData.hasChild('walletBalance') || newData.child('walletBalance').val() === 0)) && (data.child('points').exists() ? newData.child('points').val() === data.child('points').val() : (!newData.hasChild('points') || newData.child('points').val() === 0))"
      }
    },
    "rn_mall_staff": {
      ".read": true,
      "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['email','id']) && (data.child('salary').exists() ? newData.child('salary').val() === data.child('salary').val() : (!newData.hasChild('salary') || newData.child('salary').val() === 0)) && (data.child('points').exists() ? newData.child('points').val() === data.child('points').val() : (!newData.hasChild('points') || newData.child('points').val() === 0))"
      }
    },
    "rn_mall_vendors": {
      ".read": true,
      "$id": { ".write": true, ".validate": "newData.hasChildren(['email','id'])" }
    },
    "rn_mall_riders": {
      ".read": true,
      "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['email','id']) && (data.child('totalPaid').exists() ? newData.child('totalPaid').val() === data.child('totalPaid').val() : (!newData.hasChild('totalPaid') || newData.child('totalPaid').val() === 0)) && (data.child('points').exists() ? newData.child('points').val() === data.child('points').val() : (!newData.hasChild('points') || newData.child('points').val() === 0))"
      }
    },
    "rn_mall_investors": {
      ".read": true,
      "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['email','id']) && (data.child('walletBalance').exists() ? newData.child('walletBalance').val() === data.child('walletBalance').val() : (!newData.hasChild('walletBalance') || newData.child('walletBalance').val() === 0)) && (data.child('totalPaid').exists() ? newData.child('totalPaid').val() === data.child('totalPaid').val() : (!newData.hasChild('totalPaid') || newData.child('totalPaid').val() === 0))"
      }
    },

    // Orders and money. rn_mall_orders needs collection-level read: admin's
    // order list, and the customer/rider tracking flows, all fetch the whole
    // collection and filter client-side, same limitation as the login
    // lookups above. The rest are only ever accessed by a specific id in
    // the app's own code, so they stay id-scoped, closing off a full dump.
    // NOTE: pointsAwarded/referralAwarded (set by richnation-wallet-worker.js
    // once it pays out purchase/referral RichPoints for an order) are
    // deliberately NOT locked here the way the money fields above are.
    // Admin and rider order-status updates in this app work by re-writing
    // the ENTIRE order object (fbS, a full PUT) from an in-memory copy that
    // may predate the Worker setting that flag, a hard "must stay unchanged"
    // rule here would make those routine, frequent status updates start
    // failing outright whenever they happen to run after the Worker has
    // already stamped an order. The residual risk this accepts (a customer
    // resetting their own order's flag to re-trigger a repeat RichPoints
    // payout for the same order) is bounded to small, per-order point
    // amounts and requires deliberately crafting a raw request, not
    // something worth breaking a routine admin workflow to close.
    "rn_mall_orders": {
      ".read": true,
      "$id": { ".write": true }
    },
    "rn_mall_customer_orders":              { "$id": { ".read": true, ".write": true } },
    // rn_mall_processed_topups: richnation-wallet-worker.js's own record of
    // which Paystack transaction references it has already credited, so a
    // reference can never be replayed to double-credit a wallet. Only the
    // Worker ever needs to read or write this (it bypasses these rules with
    // its own trusted credential either way), no app page reads it, so it
    // stays fully denied to everyone else.
    "rn_mall_processed_topups":             { "$id": { ".read": false, ".write": false } },
    // rn_mall_processed_payments: same idea as rn_mall_processed_topups
    // above, but for order payments (full card payment or the Pay on
    // Delivery deposit) that richnation-wallet-worker.js has verified with
    // Paystack directly, so the same reference can't be replayed to fake
    // "payment confirmed" on more than one order.
    "rn_mall_processed_payments":           { "$id": { ".read": false, ".write": false } },
    "rn_mall_wallet_transactions":          { "$id": { ".read": true, ".write": true } },
    "rn_mall_wallet_transactions_investor": { "$id": { ".read": true, ".write": true } },
    // rn_mall_wallet_issues: admin's Wallet Issues page lists the whole
    // collection, same limitation as rn_mall_orders above.
    "rn_mall_wallet_issues": {
      ".read": true,
      "$id": { ".write": true }
    },
    "rn_mall_vendor_payouts":               { "$id": { ".read": true, ".write": true } },
    "rn_mall_rider_payouts":                { "$id": { ".read": true, ".write": true } },
    "rn_mall_investor_payouts":             { "$id": { ".read": true, ".write": true } },
    "rn_mall_investor_withdrawals":         { "$id": { ".read": true, ".write": true } },
    "rn_mall_staff_withdrawals":            { "$id": { ".read": true, ".write": true } },
    "rn_mall_staff_salary_history":         { "$id": { ".read": true, ".write": true } },

    // Chat: id-scoped only, no reason to ever list the whole table.
    "rn_mall_chat": { "$id": { ".read": true, ".write": true } },

    // Vendor/investor/rider-admin chat threads are NOT nested under a common
    // parent in this app, the code builds a flat, one-off top-level path per
    // thread by string concatenation (e.g. 'rn_mall_vendor_chat_'+vendor.id
    // -> a literal path named "rn_mall_vendor_chat_vend_xxxxx"). A named
    // rule for "rn_mall_vendor_chat_" would never match any of these and
    // they'd all fall through to the deny-by-default root rule, breaking
    // vendor/investor/rider chat entirely. This wildcard matches any
    // top-level path with one of those three prefixes instead, whatever id
    // happens to be appended, and denies everything else at this level
    // EXCEPT one more case bolted on below: Firebase allows only one
    // wildcard child per level, so the other app's entire "rna_" collection
    // family (academy/staff-chat, not part of this repo) has to be granted
    // its unchanged, already-open access from this same node too, rather
    // than as a second wildcard rule, which Firebase would reject outright.
    "$topLevelPath": {
      ".read": "$topLevelPath.beginsWith('rn_mall_vendor_chat_') || $topLevelPath.beginsWith('rn_mall_investor_chat_') || $topLevelPath.beginsWith('rn_mall_rider_admin_chat_') || $topLevelPath.beginsWith('rna_')",
      ".write": "$topLevelPath.beginsWith('rn_mall_vendor_chat_') || $topLevelPath.beginsWith('rn_mall_investor_chat_') || $topLevelPath.beginsWith('rn_mall_rider_admin_chat_') || $topLevelPath.beginsWith('rna_')"
    },
    // rn_mall_notifications: admin's own notification bell lists the whole
    // collection, same limitation as rn_mall_orders above. The per-role
    // notification collections below it ARE id-scoped, only this shared
    // admin one needs the wider read.
    "rn_mall_notifications": {
      ".read": true,
      "$id": { ".write": true }
    },
    // rn_mall_admin_login_attempts: the admin login-lockout counter. Has to
    // be readable/writable before login succeeds, same reason as
    // rn_mall_settings above, there is no authenticated session yet at that
    // point. $id here is the sanitised admin/CEO email, not a secret.
    "rn_mall_admin_login_attempts": {
      "$id": { ".read": true, ".write": true }
    },
    // rn_mall_admin_fcm_tokens: push-notification device tokens for the admin
    // panel. Used to be collection-readable so customers' saveOrder() could
    // push every admin device on a new order, but that meant literally
    // anyone could read the admin team's own device tokens out of this
    // collection and use them to send fake/phishing push notifications
    // straight to the team via richnation-push-worker.js (which has no login
    // of its own, see that file's notes). Fixed on both ends together: this
    // collection is no longer readable by anyone, and the push Worker now
    // looks these tokens up itself, server-side, using its own trusted
    // service-account credentials (see notifyAdmins in
    // richnation-push-worker.js) instead of trusting whatever tokens a
    // customer's browser hands it. Writing your OWN device's token to
    // register it stays open, same reason logins can't be required yet.
    "rn_mall_admin_fcm_tokens": {
      "$id": { ".write": true }
    },
    "rn_mall_customer_notifications": { "$id": { ".read": true, ".write": true } },
    "rn_mall_vendor_notifications":   { "$id": { ".read": true, ".write": true } },
    "rn_mall_staff_notifications":    { "$id": { ".read": true, ".write": true } },
    "rn_mall_rider_notifications":    { "$id": { ".read": true, ".write": true } },
    "rn_mall_investor_notifications": { "$id": { ".read": true, ".write": true } },
    "rn_mall_announcement_reads":     { "$id": { ".read": true, ".write": true } },
    // rn_mall_activity_log and rn_mall_investor_updates: both render as a
    // full feed/list in admin.html and investor.html, same limitation.
    "rn_mall_activity_log": {
      ".read": true,
      "$id": { ".write": true }
    },
    "rn_mall_investor_updates": {
      ".read": true,
      "$id": { ".write": true }
    },
    "rn_mall_rider_activity_log":   { "$id": { ".read": true, ".write": true } },
    "rn_mall_deleted_products_log": { "$id": { ".read": true, ".write": true } },
    "rn_mall_investor_switch_log":  { "$id": { ".read": true, ".write": true } },
    "rn_mall_rider_points_log":     { "$id": { ".read": true, ".write": true } },
    "rn_mall_staff_points_log":     { "$id": { ".read": true, ".write": true } },

    // HR/ops: leave requests, complaints, reports, submissions, tasks,
    // vehicles. The rider-side ones are only ever accessed by a specific
    // id, but staff.html's admin views for staff leave/complaints/reports/
    // submissions/tasks, and the logistics vehicle list, all render as a
    // full list, same limitation as rn_mall_orders above.
    "rn_mall_rider_leave":      { "$id": { ".read": true, ".write": true } },
    "rn_mall_staff_leave":      { ".read": true, "$id": { ".write": true } },
    "rn_mall_rider_complaints": { "$id": { ".read": true, ".write": true } },
    "rn_mall_staff_complaints": { ".read": true, "$id": { ".write": true } },
    "rn_mall_rider_reports":    { "$id": { ".read": true, ".write": true } },
    "rn_mall_staff_reports":    { ".read": true, "$id": { ".write": true } },
    "rn_mall_staff_submissions": { ".read": true, "$id": { ".write": true } },
    "rn_mall_staff_tasks":      { ".read": true, "$id": { ".write": true } },
    "rn_mall_logistics_vehicles": { ".read": true, "$id": { ".write": true } },

    // Newsletter: public write (the signup form has no login), but no
    // longer publicly listable — nobody can download the whole subscriber
    // list without already knowing a specific record id.
    "rn_mall_newsletter_subscribers": {
      ".write": true,
      "$id": { ".read": true }
    },

    // Website traffic counters (Visitors page in admin). One small record
    // per calendar day, incremented anonymously by every visit to
    // index.html, read as a whole date-range by the admin dashboard. No
    // per-visit log is ever written, so this never grows into something
    // expensive to read, no matter how much traffic the site gets.
    "rn_mall_analytics": {
      ".read": true,
      "$date": { ".write": true }
    }
  }
}
