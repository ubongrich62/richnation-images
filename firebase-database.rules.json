{
  "rules": {
    ".read": false,
    ".write": false,

    "mgmt_vault": { ".read": false, ".write": false },
    "mgmt_notes": { ".read": false, ".write": false },

    "channel_settings": { ".read": true, ".write": true },
    "divisions":        { ".read": true, ".write": true },
    "dm":               { ".read": true, ".write": true },
    "staff":            { ".read": true, ".write": true },
    "staff_logins":     { ".read": true, ".write": true },

    "rn_mall_products":        { ".read": true, ".write": true, "$id": { ".validate": "newData.hasChildren(['name','price'])" } },
    "rn_mall_categories":      { ".read": true, ".write": true },
    "rn_mall_reviews":         { ".read": true, ".write": true },
    "rn_mall_seasonal_promos": { ".read": true, ".write": true },
    "rn_mall_coupons":         { ".read": true, ".write": true },
    "rn_mall_bundles":         { ".read": true, ".write": true },
    "rn_mall_settings":        { ".read": true, ".write": true },
    "rn_mall_announcements":   { ".read": true, ".write": true },

    // Money fields (walletBalance/points/salary/totalPaid) can only ever
    // move via richnation-wallet-worker.js. That Worker signs itself in as
    // a real Firebase Auth identity carrying a "worker: true" custom
    // claim (see getWorkerIdToken in that file) and every check below
    // explicitly trusts that claim, and ONLY that claim, to skip the
    // frozen-value check for its own field. A raw service-account OAuth2
    // token does NOT get this exception (confirmed by testing, contrary
    // to what Firebase's docs on admin-token bypass implied) and neither
    // does any other signed-in user, so this is a real, checkable grant,
    // not a hopeful assumption about credential type.
    "rn_mall_customers": {
      ".read": true,
      "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['email','id']) && ((auth != null && auth.token.worker === true) || (data.child('walletBalance').exists() ? newData.child('walletBalance').val() === data.child('walletBalance').val() : (!newData.hasChild('walletBalance') || newData.child('walletBalance').val() === 0))) && ((auth != null && auth.token.worker === true) || (data.child('points').exists() ? newData.child('points').val() === data.child('points').val() : (!newData.hasChild('points') || newData.child('points').val() === 0)))"
      }
    },
    "rn_mall_staff": {
      ".read": true,
      "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['email','id']) && ((auth != null && auth.token.worker === true) || (data.child('salary').exists() ? newData.child('salary').val() === data.child('salary').val() : (!newData.hasChild('salary') || newData.child('salary').val() === 0))) && ((auth != null && auth.token.worker === true) || (data.child('points').exists() ? newData.child('points').val() === data.child('points').val() : (!newData.hasChild('points') || newData.child('points').val() === 0)))"
      }
    },
    "rn_mall_vendors": {
      ".read": true,
      "$id": { ".write": true, ".validate": "newData.hasChildren(['email','id'])" }
    },
    "rn_mall_riders": {
      ".read": true,
      "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['email','id']) && ((auth != null && auth.token.worker === true) || (data.child('totalPaid').exists() ? newData.child('totalPaid').val() === data.child('totalPaid').val() : (!newData.hasChild('totalPaid') || newData.child('totalPaid').val() === 0))) && ((auth != null && auth.token.worker === true) || (data.child('points').exists() ? newData.child('points').val() === data.child('points').val() : (!newData.hasChild('points') || newData.child('points').val() === 0)))"
      }
    },
    "rn_mall_investors": {
      ".read": true,
      "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['email','id']) && ((auth != null && auth.token.worker === true) || (data.child('walletBalance').exists() ? newData.child('walletBalance').val() === data.child('walletBalance').val() : (!newData.hasChild('walletBalance') || newData.child('walletBalance').val() === 0))) && ((auth != null && auth.token.worker === true) || (data.child('totalPaid').exists() ? newData.child('totalPaid').val() === data.child('totalPaid').val() : (!newData.hasChild('totalPaid') || newData.child('totalPaid').val() === 0)))"
      }
    },

    "rn_mall_orders": { ".read": true, "$id": { ".write": true } },
    "rn_mall_customer_orders":              { "$id": { ".read": true, ".write": true } },
    // Only the Worker (its own idempotency ledger, so a Paystack reference
    // can never be replayed to double-credit) ever needs these, gated the
    // same way the money-field exception above is.
    "rn_mall_processed_topups":             { "$id": { ".read": "auth != null && auth.token.worker === true", ".write": "auth != null && auth.token.worker === true" } },
    "rn_mall_processed_payments":           { "$id": { ".read": "auth != null && auth.token.worker === true", ".write": "auth != null && auth.token.worker === true" } },
    "rn_mall_wallet_transactions":          { "$id": { ".read": true, ".write": true } },
    "rn_mall_wallet_transactions_investor": { "$id": { ".read": true, ".write": true } },
    "rn_mall_wallet_issues": { ".read": true, "$id": { ".write": true } },
    "rn_mall_vendor_payouts":               { "$id": { ".read": true, ".write": true } },
    "rn_mall_rider_payouts":                { "$id": { ".read": true, ".write": true } },
    "rn_mall_investor_payouts":             { "$id": { ".read": true, ".write": true } },
    "rn_mall_investor_withdrawals":         { "$id": { ".read": true, ".write": true } },
    "rn_mall_staff_withdrawals":            { "$id": { ".read": true, ".write": true } },
    "rn_mall_staff_salary_history":         { "$id": { ".read": true, ".write": true } },

    "rn_mall_chat": { "$id": { ".read": true, ".write": true } },

    "$topLevelPath": {
      ".read": "$topLevelPath.beginsWith('rn_mall_vendor_chat_') || $topLevelPath.beginsWith('rn_mall_investor_chat_') || $topLevelPath.beginsWith('rn_mall_rider_admin_chat_') || $topLevelPath.beginsWith('rna_')",
      ".write": "$topLevelPath.beginsWith('rn_mall_vendor_chat_') || $topLevelPath.beginsWith('rn_mall_investor_chat_') || $topLevelPath.beginsWith('rn_mall_rider_admin_chat_') || $topLevelPath.beginsWith('rna_')"
    },

    "rn_mall_notifications": { ".read": true, "$id": { ".write": true } },
    "rn_mall_admin_login_attempts": { "$id": { ".read": true, ".write": true } },
    "rn_mall_admin_fcm_tokens":     { "$id": { ".write": true } },
    "rn_mall_customer_notifications": { "$id": { ".read": true, ".write": true } },
    "rn_mall_vendor_notifications":   { "$id": { ".read": true, ".write": true } },
    "rn_mall_staff_notifications":    { "$id": { ".read": true, ".write": true } },
    "rn_mall_rider_notifications":    { "$id": { ".read": true, ".write": true } },
    "rn_mall_investor_notifications": { "$id": { ".read": true, ".write": true } },
    "rn_mall_announcement_reads":     { "$id": { ".read": true, ".write": true } },
    "rn_mall_activity_log":     { ".read": true, "$id": { ".write": true } },
    "rn_mall_investor_updates": { ".read": true, "$id": { ".write": true } },
    "rn_mall_rider_activity_log":   { "$id": { ".read": true, ".write": true } },
    "rn_mall_deleted_products_log": { "$id": { ".read": true, ".write": true } },
    "rn_mall_investor_switch_log":  { "$id": { ".read": true, ".write": true } },
    "rn_mall_rider_points_log":     { "$id": { ".read": true, ".write": true } },
    "rn_mall_staff_points_log":     { "$id": { ".read": true, ".write": true } },

    "rn_mall_rider_leave":      { "$id": { ".read": true, ".write": true } },
    "rn_mall_staff_leave":      { ".read": true, "$id": { ".write": true } },
    "rn_mall_rider_complaints": { "$id": { ".read": true, ".write": true } },
    "rn_mall_staff_complaints": { ".read": true, "$id": { ".write": true } },
    "rn_mall_rider_reports":    { "$id": { ".read": true, ".write": true } },
    "rn_mall_staff_reports":    { ".read": true, "$id": { ".write": true } },
    "rn_mall_staff_submissions": { ".read": true, "$id": { ".write": true } },
    "rn_mall_staff_tasks":      { ".read": true, "$id": { ".write": true } },
    "rn_mall_logistics_vehicles": { ".read": true, "$id": { ".write": true } },

    "rn_mall_newsletter_subscribers": { ".write": true, "$id": { ".read": true } },

    "rn_mall_analytics": { ".read": true, "$date": { ".write": true } }
  }
}
